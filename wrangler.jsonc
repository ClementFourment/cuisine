{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuisine",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Toutes les URL inconnues renvoient index.html (appli React), sauf /api/* qui passe par le Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cuisine",
      "database_id": "fc47b9bc-2408-432a-a87e-64bcb8a7270e",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "cuisine.clementfourment.fr", "custom_domain": true }],
  "observability": { "enabled": true }
}
