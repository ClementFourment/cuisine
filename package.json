{
  "name": "cuisine",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -b",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cuisine --local",
    "db:migrate:remote": "wrangler d1 migrations apply cuisine --remote",
    "seed:make": "node scripts/make-seed.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClementFourment/cuisine.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/ClementFourment/cuisine/issues"
  },
  "homepage": "https://github.com/ClementFourment/cuisine#readme",
  "dependencies": {
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  },
  "private": true
}
